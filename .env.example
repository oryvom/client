# Copy to .env.local for development. Do not commit real secrets.

# Resend. Both values are required before enquiry emails can be delivered.
# The from address must use a domain you have verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ORYVOM Mobility <notifications@oryvom.com>

# Inbox that receives contact, partnership and career notifications.
CONTACT_TO_EMAIL=work@oryvom.com

# Private resume storage. This path must not be inside public/.
# On a long-running Node host, a directory on disk is enough for development.
# On serverless hosts the disk is ephemeral. Use a persistent private volume,
# or treat the email attachment as the copy of record and set this to a
# writable temporary directory only if you accept that files will not remain.
RESUME_STORAGE_DIR=storage/resumes

# Maximum PDF resume size in bytes. Default in code is 4000000.
# Keep this under your host's request-body limit. Vercel hobby is about 4.5 MB.
RESUME_MAX_BYTES=4000000

# Form rate limit, per IP address and per form.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5

# The canonical domain is https://oryvom.com, set in src/config/company.ts.
# Optional analytics. Leave both unset to keep the site free of tracking.
# A banner is shown only when NEXT_PUBLIC_ANALYTICS_ID is set.
# The script at NEXT_PUBLIC_ANALYTICS_SRC loads only after the visitor accepts analytics.
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_ANALYTICS_SRC=
